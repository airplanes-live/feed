
[Unit]
Description=airplanes-mlat
Wants=network-online.target
After=network-online.target airplanes-first-run.service

[Service]
User=airplanes-feed
RuntimeDirectory=airplanes/mlat
RuntimeDirectoryPreserve=yes
ExecStart=/opt/airplanes/current/share/airplanes/airplanes-mlat.sh
Type=simple
Restart=always
RestartSec=30
RestartPreventExitStatus=64
StartLimitInterval=1
StartLimitBurst=100
SyslogIdentifier=airplanes-mlat
Nice=-1

[Install]
WantedBy=default.target
