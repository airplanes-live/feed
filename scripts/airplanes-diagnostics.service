[Unit]
Description=airplanes.live feeder diagnostics push
Wants=network-online.target
After=network-online.target airplanes-feed.service

[Service]
Type=oneshot
User=airplanes-feed
StateDirectory=airplanes
StateDirectoryMode=0750
RuntimeDirectory=airplanes-diagnostics
RuntimeDirectoryMode=0700
ExecStart=/usr/local/share/airplanes/airplanes-diagnostics.sh
TimeoutStartSec=45s
SyslogIdentifier=airplanes-diagnostics
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/airplanes
